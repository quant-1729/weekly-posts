# Copy to .env.local (local) and add the same names in the Vercel project settings (Production, and Preview if you use it).
# Never commit .env.local.

# Postgres connection string of the main app's Supabase database (Project Settings > Database > Connection string >
# Transaction pooler, port 6543). Server-only. Better than the service connection: a dedicated read-mostly role, see README.
ADMIN_DATABASE_URL=
# Optional: PEM text of the CA certificate (Supabase: Project Settings > Database > SSL > Download certificate) so the
# connection verifies the server. Blank = encrypted but the server certificate is not verified.
ADMIN_DATABASE_CA=

# Who may sign in: comma-separated email addresses (case does not matter). Anyone else gets the same "check your inbox"
# answer and no email is sent.
ADMIN_EMAILS=

# 32+ random characters; signs sign-in links and session cookies. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
ADMIN_AUTH_SECRET=

# Resend sends the sign-in link.
RESEND_API_KEY=
EMAIL_FROM=                  # e.g. "Weekly Posts Admin <admin@your-verified-domain.com>"

# The public address of this dashboard, no trailing slash (used in the sign-in link).
ADMIN_APP_URL=http://localhost:3100
