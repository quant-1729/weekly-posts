# Copy to .env.local and fill in. Never commit .env.local.

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
DATA_BACKEND=mock            # mock (PGlite + mock email link sign-in + local files) | supabase
# Where files go (C-32): mock (local files in .data/storage) | supabase (Supabase Storage) | gcs (Cloud Storage).
# Blank = follow DATA_BACKEND. Production on Cloud Run: gcs.
STORAGE_BACKEND=
# gcs only: bucket names are `<prefix>-<bucket>` (brand-assets, inputs, renders, mascots, photos), e.g. weeklyposts-prod-renders.
# GCS bucket names are global, so pick a prefix nobody else has. Lower case letters, digits and dashes.
GCS_BUCKET_PREFIX=
AUTH_SECRET=                 # mock sessions: any random string of 32+ characters

# Offline city/country lookup for sign-in sessions (DB-IP "IP to City Lite" .mmdb, CC BY 4.0, "IP geolocation by DB-IP").
# Blank = no lookup (city and country stay empty). The Docker image downloads it to /app/geoip/dbip-city-lite.mmdb and sets this.
# Locally: node scripts/fetch-geoip.mjs .data/dbip-city-lite.mmdb  then GEOIP_DB_PATH=.data/dbip-city-lite.mmdb
GEOIP_DB_PATH=

# Email (Resend). Blank = mock outbox: emails are written to .data/outbox and shown at /dev/outbox.
# Real sending needs a verified sending domain with SPF, DKIM and DMARC set up, or mail lands in spam.
RESEND_API_KEY=
EMAIL_FROM=                  # e.g. "Weekly Posts <hello@your-verified-domain.com>"
EMAIL_REPLY_TO=              # optional

# Who may open the read-only /admin monitoring page: comma-separated sign-in emails (case does not matter).
# Blank = nobody (the page answers 404). Example: ADMIN_EMAILS=you@example.com,partner@example.com
ADMIN_EMAILS=

# LLM (Gemini): captions, plans, guardrail, voice transcription, mascot concepts.
# Option 1, Vertex AI (in use): Google Cloud project + credentials file path.
GOOGLE_GENAI_USE_VERTEXAI=true
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global
GOOGLE_APPLICATION_CREDENTIALS=  # absolute path to the credentials JSON (never inside this repo)
GOOGLE_SERVICE_ACCOUNT_JSON=     # Hosting: the whole key file contents instead of a path (takes priority when set). Used for Vertex AI and
                                 # Cloud Storage. On Cloud Run it can stay blank if the service runs as a service account with the roles in docs/deploy.md (keyless).
# Option 2, AI Studio key (aistudio.google.com > Get API key); used only if Vertex is off.
GEMINI_API_KEY=
GEMINI_MODEL=                # blank = gemini-3.8-flash
GEMINI_TRANSCRIBE_MODEL=     # blank = gemini-3.8-flash
AI_MODE=                     # blank = live when credentials exist; "fixture" = no AI calls
# Abstract backgrounds (C-18). Imagen is not in every project's model list; a Gemini image model works too (ids starting "imagen" use generateImages, others generateContent).
IMAGEN_MODEL=                # blank = imagen-4.0-generate-001; e.g. gemini-2.5-flash-image
IMAGEN_LOCATION=             # blank = us-central1 (Imagen needs a regional endpoint, not "global")

# Supabase, later (Project Settings > API Keys)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_URL=             # pooler connection string, transaction mode

# Website reader for sites that build their pages with JavaScript (the HTML has almost no text).
# Used only for those pages: their address (no query string) is sent to Jina Reader (r.jina.ai).
# READER_PROVIDER: jina (default) | off. READER_API_KEY: optional; jina.ai > API key. Without a key Jina allows about 20 requests a minute.
READER_PROVIDER=             # blank = jina
READER_API_KEY=

# Instagram import: reads an owner's recent PUBLIC posts from their @name with Meta's Business Discovery (no login on their side).
# Works only for Business or Creator accounts. Without the first two values below the feature is off: owners see the
# screenshot / pasted-text option only (their @name is still saved).
# Setup (Meta developer account): create a Meta app with Instagram API using Facebook Login, link a Facebook Page to our
# Instagram professional account, then in Meta Business Settings > Users > System users create a system user, assign the
# app and the Page, and generate a token (never expires) with instagram_basic, instagram_manage_insights, pages_read_engagement.
# A 60-day user token also works but must be renewed.
INSTAGRAM_LOOKUP_USER_ID=    # our Instagram professional account's id (the Instagram user id, digits only)
INSTAGRAM_LOOKUP_TOKEN=      # the system user (or user) token; server only, never logged
META_GRAPH_VERSION=          # blank = v23.0
INSTAGRAM_MODE=              # "fixture" = made-up accounts and photos, no Meta calls (development and tests only)

# Background removal, week 2 (remove.bg > API) - optional
REMOVE_BG_API_KEY=

# WhatsApp Cloud API, week 3 (developers.facebook.com > your app > WhatsApp > API Setup)
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=       # any random string you choose

# Signed no-login email links (approve/edit/skip, check-in, pause): 32+ random characters in production
EMAIL_LINK_SECRET=
# Protects /api/cron/* (weekly generation, reminders); Cloud Scheduler (scripts/gcp/scheduler.sh) or Vercel Cron sends it as a Bearer token
CRON_SECRET=

# Tween, the in-app guide. Set to 0 (or false/off) to turn it off without a deploy of new content.
# TWEEN_ENABLED=1

# --- Set by the platform, not by you ---
# PORT: Cloud Run sets it (8080); the Docker image listens on it. Locally the dev server uses 3000.
# K_SERVICE: Cloud Run sets it. When present the app treats the deployment as hosted production and refuses mock sign-in.
# On Cloud Run every variable above goes in as a plain setting or a Secret Manager secret: see docs/deploy.md and cloudbuild.yaml.

# --- Connect Instagram / Facebook so we can publish for the owner (C-25, C-26) ---
# Token encryption (AES-256-GCM). Required in production before anyone can connect; blank in development uses a temporary key
# (saved tokens stop working when the server restarts). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENCRYPTION_KEY=
# Meta app (developers.facebook.com): Facebook Login for Pages + the data-deletion and deauthorize callbacks. Blank = the Connect buttons say setup is pending.
META_APP_ID=
META_APP_SECRET=
# Instagram API with Instagram Login (Meta app > Instagram > API setup with Instagram login): its own app id and secret, shown there.
# Blank = use META_APP_ID / META_APP_SECRET (only right if you copied the same values).
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
# Redirect URIs to add in the Meta app (built from NEXT_PUBLIC_APP_URL):
#   Instagram: {NEXT_PUBLIC_APP_URL}/api/connect/instagram/callback     Facebook: {NEXT_PUBLIC_APP_URL}/api/connect/facebook/callback
#   Data deletion: {NEXT_PUBLIC_APP_URL}/api/meta/data-deletion          Deauthorize: {NEXT_PUBLIC_APP_URL}/api/meta/deauthorize
# Publishing needs picture links Meta can fetch: STORAGE_BACKEND=gcs (or supabase). The mock storage cannot publish.

# Ideas (trend research). YOUTUBE_API_KEY (YouTube Data API v3, free quota) is optional: blank = the YouTube source is skipped.
YOUTUBE_API_KEY=
# Competitor Instagram through Business Discovery (the brand's Facebook connection). Keep off until Meta App Review approves it; only "on" turns it on.
IDEAS_BUSINESS_DISCOVERY=

# Brand Face (F-5): image model for faces (default gemini-3.1-flash-image at location "global"),
# and the background cut-out service for owners' own photos (services/cutout, Cloud Run).
FACE_IMAGE_MODEL=
FACE_IMAGE_LOCATION=
CUTOUT_URL=
CUTOUT_TOKEN=
