# Copy to .env.local and fill in. Never commit .env.local.

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
DATA_BACKEND=mock            # mock (PGlite + mock email link sign-in + local files) | supabase
AUTH_SECRET=                 # mock sessions: any random string of 32+ characters

# Email (Resend). Blank = mock outbox: emails are written to .data/outbox and shown at /dev/outbox.
# Real sending needs a verified sending domain with SPF, DKIM and DMARC set up, or mail lands in spam.
RESEND_API_KEY=
EMAIL_FROM=                  # e.g. "Weekly Posts <hello@your-verified-domain.com>"
EMAIL_REPLY_TO=              # optional

# LLM (Gemini): captions, plans, guardrail, voice transcription, mascot concepts.
# Option 1, Vertex AI (in use): Google Cloud project + credentials file path.
GOOGLE_GENAI_USE_VERTEXAI=true
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global
GOOGLE_APPLICATION_CREDENTIALS=  # absolute path to the credentials JSON (never inside this repo)
# Option 2, AI Studio key (aistudio.google.com > Get API key); used only if Vertex is off.
GEMINI_API_KEY=
GEMINI_MODEL=                # blank = gemini-3.8-flash
GEMINI_TRANSCRIBE_MODEL=     # blank = gemini-3.8-flash
AI_MODE=                     # blank = live when credentials exist; "fixture" = no AI calls

# Supabase, later (Project Settings > API Keys)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_URL=             # pooler connection string, transaction mode

# Background removal, week 2 (remove.bg > API) - optional
REMOVE_BG_API_KEY=

# WhatsApp Cloud API, week 3 (developers.facebook.com > your app > WhatsApp > API Setup)
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=       # any random string you choose

# Signed no-login email links (approve/edit/skip, check-in, pause): 32+ random characters in production
EMAIL_LINK_SECRET=
# Protects /api/cron/* (weekly generation, reminders); Vercel Cron sends it as a Bearer token
CRON_SECRET=
