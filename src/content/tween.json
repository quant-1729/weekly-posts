    "voiceOff": "Turn off Tween's voice",
    "restart": "Start over",
    "noRoam": "Don't roam",
    "roam": "Let Tween roam",
    "settings": "Settings",
    "settingsLabel": "Tween settings",
    "quickLabel": "Quick controls",
    "transcriptShow": "Show conversation",
    "transcriptHide": "Hide conversation",
    "transcriptLabel": "Conversation so far",
    "speakerTween": "Tween",
    "speakerYou": "You",
    "skip": "Skip typing",
    "dismiss": "Dismiss",
    "choicesLabel": "Choose a reply",
    "thinking": "Tween is thinking",
    "closeButton": "Close"
  }
}
